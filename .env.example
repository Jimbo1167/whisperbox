# Whisperbox reads this file (as .env in the project root) from every entry
# point, wherever you run it from. Variables already set in your environment
# take precedence over the values here.

# ASR engine: parakeet (Apple Silicon only) or whisper. Leave unset to use the
# platform default: parakeet on Apple Silicon, whisper everywhere else.
# TRANSCRIPTION_ENGINE=whisper

# Whisper model: any name faster-whisper accepts (tiny, base, small, medium,
# large-v3, large-v3-turbo, distil-large-v3, a Hugging Face repo id or a local
# path). Only used when the Whisper engine runs.
WHISPER_MODEL=large-v3-turbo

# Whisper speed/accuracy tuning (optional)
# Beam size: 1 (greedy) is ~2x faster than the default 5
# WHISPER_BEAM_SIZE=5
# CPU threads: 0 keeps the ctranslate2 default (4)
# WHISPER_CPU_THREADS=0
# Batch size: >0 enables batched (parallel chunk) decoding; 0 = sequential
# WHISPER_BATCH_SIZE=0

# Parakeet model: HF id or local path to MLX-format weights (only used when the Parakeet engine runs)
PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3

# Output format (txt, srt, vtt, vtt-voice, json, json3, pretty)
OUTPUT_FORMAT=txt

# Language for Whisper (en, fr, de, etc.). Parakeet detects the language itself.
LANGUAGE=en

# Speaker diarization settings
# INCLUDE_DIARIZATION is the default for the model server and for
# transcribe_video.py / `make transcribe`. The transcribe, stream, batch and
# client commands diarize only when you pass --diarize.
INCLUDE_DIARIZATION=false
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Hugging Face token with access to DIARIZATION_MODEL (needed for diarization)
HF_TOKEN=your_huggingface_token_here

# Processing settings
# Run Whisper and pyannote diarization on the CPU even when a GPU is available
# (the code default is false). No effect on Parakeet.
FORCE_CPU=true

# Stage timeouts in seconds
AUDIO_TIMEOUT=300
TRANSCRIBE_TIMEOUT=3600
DIARIZE_TIMEOUT=3600

# Cache settings (cache lives in ~/.cache/whisperbox)
CACHE_ENABLED=true
CACHE_EXPIRATION=604800  # 7 days in seconds
MAX_CACHE_SIZE=10737418240  # 10GB in bytes

# Warm model server that transcribe_video.py / `make transcribe` uses when one
# is running with the same engine, model and language (optional)
# WHISPERBOX_SERVER_URL=http://localhost:8000
# Set to 1 to always transcribe in-process
# WHISPERBOX_NO_SERVER=1
