# ASR engine: parakeet (Apple Silicon only) or whisper. Leave unset to use the
# platform default: parakeet on Apple Silicon, whisper everywhere else.
# TRANSCRIPTION_ENGINE=whisper

# Whisper model size (tiny, base, small, medium, large-v2, large-v3, large-v3-turbo)
WHISPER_MODEL=large-v3-turbo

# Whisper speed/accuracy tuning (optional)
# Beam size: 1 (greedy) is ~2x faster than the default 5
# WHISPER_BEAM_SIZE=5
# CPU threads: 0 keeps the ctranslate2 default (4)
# WHISPER_CPU_THREADS=0
# Batch size: >0 enables batched (parallel chunk) decoding; 0 = sequential
# WHISPER_BATCH_SIZE=0

# Parakeet model: HF id or local path to MLX-format weights (only used when TRANSCRIPTION_ENGINE=parakeet)
PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3

# Output format (txt, srt, vtt, json)
OUTPUT_FORMAT=txt

# Language settings (en, fr, de, etc.)
LANGUAGE=en

# Speaker diarization settings
INCLUDE_DIARIZATION=false
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HF_TOKEN=your_huggingface_token_here

# Processing settings
FORCE_CPU=true

# Stage timeouts in seconds
AUDIO_TIMEOUT=300
TRANSCRIBE_TIMEOUT=3600
DIARIZE_TIMEOUT=3600

# Cache settings
CACHE_ENABLED=true
CACHE_EXPIRATION=604800  # 7 days in seconds
MAX_CACHE_SIZE=10737418240  # 10GB in bytes
